{
  "fields": [
    {
      "name": "doc_id",
      "type": "String",
      "filterable": true,
      "description": "全文 artifact 内容哈希（sha256）。仅在文档存在全文时返回；没有全文的元数据记录不返回 doc_id，也无法用此字段过滤命中。如需引用无全文的记录请用 unique_id。OS 端 sha256 字段为裸 keyword，过滤直接走主字段精确匹配。",
      "operators": [
        "FILTER_OP_EQ",
        "FILTER_OP_NE",
        "FILTER_OP_IN",
        "FILTER_OP_NIN",
        "FILTER_OP_CONTAINS"
      ],
      "group": "system",
      "projectable": true,
      "sortable": false,
