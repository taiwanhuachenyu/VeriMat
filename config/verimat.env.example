# Copy to .env and fill only local credentials. Never commit .env.
SCIVERSE_API_TOKEN=sci_REPLACE_WITH_SCIVERSE_TOKEN
SCIVERSE_BASE_URL=https://api.sciverse.space

# Model route: claude-code or opencode
VERIMAT_MODEL_ROUTE=claude-code

# Claude Code route. The CLI must already be authenticated.
# VERIMAT_CLAUDE_CLI=claude
# VERIMAT_CLAUDE_CODE_MODEL=claude-opus-5

# OpenCode route. The API key is consumed by the local OpenCode server.
# VERIMAT_OPENCODE_BASE_URL=http://127.0.0.1:4096
# VERIMAT_OPENCODE_PROVIDER=anthropic
# VERIMAT_OPENCODE_MODEL=claude-opus-5
# VERIMAT_OPENCODE_AGENT=benchmark
# VERIMAT_OPENCODE_API_KEY=REPLACE_WITH_PROVIDER_KEY
