# Copy to .env and fill only local credentials. Never commit .env.
SCIVERSE_API_TOKEN=sci_REPLACE_WITH_SCIVERSE_TOKEN
SCIVERSE_BASE_URL=https://api.sciverse.space

# Formal v2 route. The same StructuredModelTransport also supports claude-code.
VERIMAT_MODEL_ROUTE=opencode

# Claude Code route. The CLI must already be authenticated.
# VERIMAT_CLAUDE_CLI=claude
# VERIMAT_CLAUDE_CODE_MODEL=claude-opus-5

# OpenCode route used by the formal v2 run. The provider credential stays inside the local
# OpenCode server; VERIMAT_OPENCODE_API_KEY is only the non-secret client header expected by
# StructuredModelTransport.
VERIMAT_OPENCODE_BASE_URL=http://127.0.0.1:4124
VERIMAT_OPENCODE_PROVIDER=zhipuai
VERIMAT_OPENCODE_MODEL=glm-5.3-flash
VERIMAT_OPENCODE_AGENT=build
VERIMAT_OPENCODE_API_KEY=held-by-server
