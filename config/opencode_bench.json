{
  "$schema": "https://opencode.ai/config.json",
  "model": "zhipuai/glm-5.3-flash",
  "provider": {
    "zhipuai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Zhipu AI Coding Plan",
      "options": {
        "baseURL": "https://open.bigmodel.cn/api/coding/paas/v4",
        "apiKey": "REPLACE_WITH_ZHIPU_CODING_PLAN_KEY"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM-5.2 Kucha",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true
        },
        "glm-5.3": {
          "name": "GLM-5.3",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true,
          "variants": {
            "low": {
              "options": {
                "reasoningEffort": "low"
              }
            },
            "medium": {
              "options": {
                "reasoningEffort": "medium"
              }
            },
            "high": {
              "options": {
                "reasoningEffort": "high"
              }
            },
            "max": {
              "options": {
                "reasoningEffort": "max"
              }
            }
          }
        },
        "glm-5.3-flash": {
          "name": "GLM-5.3-Flash",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true,
          "variants": {
            "low": {
              "options": {
                "reasoningEffort": "low"
              }
            },
            "medium": {
              "options": {
                "reasoningEffort": "medium"
              }
            },
            "high": {
              "options": {
                "reasoningEffort": "high"
              }
            },
            "max": {
              "options": {
                "reasoningEffort": "max"
              }
            }
          },
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  },
  "agent": {
    "benchmark": {
      "mode": "primary",
      "description": "Minimal tool-free benchmark endpoint",
      "prompt": "You are a benchmark endpoint. Return exactly the JSON the task's schema requires. Never call tools. No commentary.",
      "tools": {
        "bash": false,
        "read": false,
        "write": false,
        "edit": false,
        "glob": false,
        "grep": false,
        "webfetch": false,
        "task": false,
        "todowrite": false,
        "todoread": false,
        "patch": false,
        "list": false,
        "multiedit": false
      }
    }
  }
}